#!/bin/bash
#PBS -N zno_micronet
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:gpu_model=H200
#PBS -l walltime=1:00:00
#PBS -j oe
# E7: MicroNet ResNet-50 features (500x, pct stretch, p480 and n448 tilings). From .../zno_xai/code:
#   qsub -N micronet -o ../logs/micronet.out micronet.pbs
set -e
cd $PBS_O_WORKDIR
module load python/3.11.3
source /srv/scratch/$USER/envs/zno_xai/bin/activate
B=/srv/scratch/$USER/zno_xai
echo "Job $PBS_JOBID on $(hostname) started $(date)"
nvidia-smi -L || true
for f in common.py extract_features.py; do echo "PROV $(md5sum $f | cut -c1-12) $f"; done
python -u extract_features.py --sem $B/data/500x --out $B/features_micronet \
  --backbones micronet_r50,imnet_micronet_r50 --tilings p480,n448 --norms pct
echo "Finished $(date)"
