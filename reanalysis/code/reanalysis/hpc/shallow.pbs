#!/bin/bash
#PBS -N zno_shallow
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb:gpu_model=L40S
#PBS -l walltime=2:00:00
#PBS -j oe
# Shallow ImageNet CNN features (500x, pct stretch). From .../zno_xai/code:
#   qsub -q adfagpu -N shallow -o ../logs/shallow.out shallow.pbs
set -e
cd $PBS_O_WORKDIR
module load python/3.11.3
source /srv/scratch/$USER/envs/zno_xai/bin/activate
B=/srv/scratch/$USER/zno_xai
echo "Job $PBS_JOBID on $(hostname) started $(date)"
nvidia-smi -L || true
for f in common.py extract_features.py; do echo "PROV $(md5sum $f | cut -c1-12) $f"; done
python -u extract_features.py --sem $B/data/500x --out $B/features_shallow \
  --backbones resnet18,resnet18_l2,resnet50_l2,resnet50_l3 --tilings p480,n224,n448 --norms pct
echo "Finished $(date)"
